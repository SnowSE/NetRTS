<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <Description>NetRts game server: REST API for bots, live spectator stream, persistence and ratings.</Description>
    <UserSecretsId>netrts-server</UserSecretsId>
    <!-- dotnet publish -t:PublishContainer; CI pushes it to Docker Hub -->
    <ContainerRepository>netrts-server</ContainerRepository>
  </PropertyGroup>

  <ItemGroup>
    <!-- The image runs as the non-root 'app' user, which can't write to /app; mount /home/app to keep the database -->
    <ContainerEnvironmentVariable Include="ConnectionStrings__sqlite" Value="Data Source=/home/app/netrts.db" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
    <PackageReference Include="Aspire.Azure.Npgsql.EntityFrameworkCore.PostgreSQL" Version="13.6.0" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.17.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NetRts.Engine\NetRts.Engine.csproj" />
    <ProjectReference Include="..\NetRts.Bots\NetRts.Bots.csproj" />
    <ProjectReference Include="..\NetRts.ServiceDefaults\NetRts.ServiceDefaults.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NetRts.Server.Tests" />
  </ItemGroup>

</Project>

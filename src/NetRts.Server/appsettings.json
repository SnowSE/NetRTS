{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "NetRts": {
    "DefaultTickIntervalMs": 1000,
    "MinTickIntervalMs": 100,
    "DefaultMaxTicks": 1800,
    "DefaultMapSize": 64,
    "StartDelayMs": 3000,
    "MaxLiveMatches": 50,
    "MaxConcurrentExhibitions": 4,
    "RequestsPerSecond": 30,
    "RegistrationsPerMinutePerIp": 5
  }
}

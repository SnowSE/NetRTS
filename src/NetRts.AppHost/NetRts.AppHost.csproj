<Project Sdk="Aspire.AppHost.Sdk/13.6.0">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <UserSecretsId>42bd6383-193d-4906-8082-0bd8f21053ca</UserSecretsId>
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);ASPIRE010</MSBuildWarningsAsMessages>
    <!-- Aspire's Azure networking APIs (virtual network, subnets, private endpoints) are marked experimental. -->
    <NoWarn>$(NoWarn);ASPIREAZURE003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NetRts.Server\NetRts.Server.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.Azure.AppService" Version="13.6.3" />
    <PackageReference Include="Aspire.Hosting.Azure.Network" Version="13.6.3" />
    <PackageReference Include="Aspire.Hosting.Azure.PostgreSQL" Version="13.6.3" />
    <PackageReference Include="Aspire.Hosting.Azure.Storage" Version="13.6.3" />
    <!-- Aspire 13.6 brings in MessagePack 2.5.302 (GHSA-qhrr-8q5h-9q3h); drop this once Aspire moves past it. -->
    <PackageReference Include="MessagePack" Version="2.5.307" />
  </ItemGroup>

</Project>

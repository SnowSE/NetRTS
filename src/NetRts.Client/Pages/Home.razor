@page "/"
@inject NavigationManager Navigation

<PageTitle>NetRTS - Real-Time Strategy Game</PageTitle>

<div class="container mt-5">
    <div class="text-center mb-5">
        <h1 class="display-3 fw-bold">NetRTS</h1>
        <p class="lead text-muted">Real-Time Strategy Multiplayer Game</p>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg">
                <div class="card-body text-center p-5">
                    <h2 class="mb-4">Welcome Commander!</h2>
                    <p class="mb-4">Build your base, train units, and defeat your opponents in intense real-time strategic battles.</p>

                    <div class="d-grid gap-3">
                        <button class="btn btn-primary btn-lg" @onclick="GoToLobbies">
                            <i class="bi bi-grid-3x3-gap-fill me-2"></i>
                            Join a Game Lobby
                        </button>
                    </div>

                    <div class="row mt-5 text-start">
                        <div class="col-md-6">
                            <h5><i class="bi bi-lightning-fill text-warning me-2"></i>Real-Time Gameplay</h5>
                            <p class="text-muted small">Command your units in real-time with tick-based simulation</p>
                        </div>
                        <div class="col-md-6">
                            <h5><i class="bi bi-people-fill text-info me-2"></i>Multiplayer Battles</h5>
                            <p class="text-muted small">Challenge other players in head-to-head matches</p>
                        </div>
                        <div class="col-md-6">
                            <h5><i class="bi bi-eye-fill text-success me-2"></i>Fog of War</h5>
                            <p class="text-muted small">Explore the map and uncover enemy positions</p>
                        </div>
                        <div class="col-md-6">
                            <h5><i class="bi bi-cpu-fill text-danger me-2"></i>Strategic Depth</h5>
                            <p class="text-muted small">Manage resources, build structures, and train armies</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private void GoToLobbies()
    {
        Navigation.NavigateTo("/lobbies");
    }
}

        bottom: 0;
        background: #1a1a1a;
        display: flex;
        align-items: center;
        justify-content: center;
    }
</style>

@code {
    [Parameter]
    public Guid MatchId { get; set; }

    private GameStateResponse? gameState;
    private HubConnection? hubConnection;
    private bool isConnected = false;
    private Guid playerId => AuthService.PlayerId;
    private int cellSize = 24;
    private HashSet<int> selectedUnitIds = new();
    private int? selectedBuildingId = null;
    private CommandMode commandMode = CommandMode.None;
    private string? buildingTypeToBuild = null;

    private enum CommandMode
    {
        None,
        Move,
        Attack,
        Gather,
        Build
    }

    protected override async Task OnInitializedAsync()
    {
        if (!AuthService.IsAuthenticated)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        await LoadGameState();
        await InitializeSignalR();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && gameState != null)
        {
            // Auto-scroll to player's base/units on first load
            await ScrollToPlayerBase();
        }
    }

    private async Task LoadGameState()
    {
        try
        {
            gameState = await Http.GetFromJsonAsync<GameStateResponse>($"api/v1/matches/{MatchId}/state");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading game state: {ex.Message}");
        }
    }

    private async Task InitializeSignalR()
    {
        hubConnection = new HubConnectionBuilder()
            .WithUrl(Navigation.ToAbsoluteUri("/hubs/game"))
            .WithAutomaticReconnect()
            .Build();

        hubConnection.On<GameStateResponse>("GameStateUpdate", async (state) =>
        {
            Console.WriteLine($"Received GameStateUpdate - Tick: {state.CurrentTick}, Units: {state.Units.Count}");
            gameState = state;
            await InvokeAsync(StateHasChanged);
        });

        hubConnection.On("MatchEnded", async (object matchEndedEvent) =>
        {
            Console.WriteLine("Match ended!");
            // Refresh game state to get final results
            await LoadGameState();
            await InvokeAsync(StateHasChanged);
        });

        hubConnection.Reconnecting += error =>
        {
            isConnected = false;
            InvokeAsync(StateHasChanged);
            return Task.CompletedTask;
        };

        hubConnection.Reconnected += async connectionId =>
        {
            isConnected = true;
            // Re-subscribe with player ID for personalized updates
            await hubConnection.SendAsync("SubscribeToMatchAsPlayer", MatchId, playerId);
            await InvokeAsync(StateHasChanged);
        };

        hubConnection.Closed += error =>
        {
            isConnected = false;
            InvokeAsync(StateHasChanged);
            return Task.CompletedTask;
        };

        try
        {
            await hubConnection.StartAsync();
            // Subscribe with player ID to get personalized fog-of-war updates
            await hubConnection.SendAsync("SubscribeToMatchAsPlayer", MatchId, playerId);
            isConnected = true;
            Console.WriteLine($"SignalR connected and subscribed to match {MatchId} as player {playerId}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error connecting to SignalR: {ex.Message}");
        }
    }

    private async Task ScrollToPlayerBase()
    {
        // Find the player's command center or first unit
        var commandCenter = GetMyBuildings().FirstOrDefault(b => b.BuildingType == "CommandCenter");
        var firstUnit = GetMyUnits().FirstOrDefault();
        
        int scrollX = 0;
        int scrollY = 0;

        if (commandCenter != null)
        {
            scrollX = (commandCenter.Position.X * cellSize) - 400; // Center in viewport
            scrollY = (commandCenter.Position.Y * cellSize) - 300;
        }
        else if (firstUnit != null)
        {
            scrollX = (firstUnit.Position.X * cellSize) - 400;
            scrollY = (firstUnit.Position.Y * cellSize) - 300;
        }

        // Ensure scroll values are non-negative
        scrollX = Math.Max(0, scrollX);
        scrollY = Math.Max(0, scrollY);

        await JS.InvokeVoidAsync("scrollMapTo", scrollX, scrollY);
    }

    private async Task HandleCellClick(int x, int y)
    {
        if (commandMode == CommandMode.None || !selectedUnitIds.Any())
        {
            // If clicking on fog of war, ignore
            return;
        }

        try
        {
            var command = commandMode switch
            {
                CommandMode.Move => new
                {
                    CommandType = "Move",
                    UnitIds = selectedUnitIds.ToArray(),
                    TargetPosition = new { X = x, Y = y },
                    BuildingType = (string?)null,
                    TargetId = (int?)null
                },
                CommandMode.Attack => new
                {
                    CommandType = "AttackMove",
                    UnitIds = selectedUnitIds.ToArray(),
                    TargetPosition = new { X = x, Y = y },
                    BuildingType = (string?)null,
                    TargetId = (int?)null
                },
                CommandMode.Gather => new
                {
                    CommandType = "Gather",
                    UnitIds = selectedUnitIds.ToArray(),
                    TargetPosition = new { X = x, Y = y },
                    BuildingType = (string?)null,
                    TargetId = (int?)null
                },
                CommandMode.Build => new
                {
                    CommandType = "Build",
                    UnitIds = selectedUnitIds.ToArray(),
                    TargetPosition = new { X = x, Y = y },
                    BuildingType = buildingTypeToBuild,
                    TargetId = (int?)null
                },
                _ => (object?)null
            };

            if (command != null)
            {
                await Http.PostAsJsonAsync($"api/v1/matches/{MatchId}/commands", new
                {
                    Commands = new[] { command }
                });
            }

            commandMode = CommandMode.None;
            buildingTypeToBuild = null;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error issuing command: {ex.Message}");
        }
    }

    private async Task ProduceUnit(int buildingId, string unitType)
    {
        try
        {
            await Http.PostAsJsonAsync($"api/v1/matches/{MatchId}/commands", new
            {
                Commands = new[]
                {
                    new
                    {
                        CommandType = "Produce",
                        BuildingId = buildingId,
                        UnitType = unitType
                    }
                }
            });
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error issuing produce command: {ex.Message}");
        }
    }

    private void SelectUnit(int unitId)
    {
        if (selectedUnitIds.Contains(unitId))
        {
            selectedUnitIds.Remove(unitId);
        }
        else
        {
            selectedUnitIds.Add(unitId);
        }
        selectedBuildingId = null;
        commandMode = CommandMode.None;
    }

    private void SelectBuilding(int buildingId)
    {
        selectedBuildingId = buildingId;
        selectedUnitIds.Clear();
        commandMode = CommandMode.None;
    }

    private void SelectAllWorkers()
    {
        selectedUnitIds = GetMyUnits()
            .Where(u => u.UnitType == "Worker")
            .Select(u => u.UnitId)
            .ToHashSet();
        selectedBuildingId = null;
        commandMode = CommandMode.None;
    }

    private void SelectAllCombatUnits()
    {
        selectedUnitIds = GetMyUnits()
            .Where(u => u.UnitType != "Worker")
            .Select(u => u.UnitId)
            .ToHashSet();
        selectedBuildingId = null;
        commandMode = CommandMode.None;
    }

    private async Task CenterOnBase()
    {
        var commandCenter = GetMyBuildings().FirstOrDefault(b => b.BuildingType == "CommandCenter");
        if (commandCenter != null)
        {
            SelectBuilding(commandCenter.BuildingId);
            
            int scrollX = (commandCenter.Position.X * cellSize) - 400;
            int scrollY = (commandCenter.Position.Y * cellSize) - 300;
            scrollX = Math.Max(0, scrollX);
            scrollY = Math.Max(0, scrollY);
            
            await JS.InvokeVoidAsync("scrollMapTo", scrollX, scrollY);
        }
    }

    private void ClearSelection()
    {
        selectedUnitIds.Clear();
        selectedBuildingId = null;
        commandMode = CommandMode.None;
        buildingTypeToBuild = null;
    }

    private void CancelCommand()
    {
        commandMode = CommandMode.None;
        buildingTypeToBuild = null;
    }

    private void EnableMoveMode() => commandMode = CommandMode.Move;
    private void EnableAttackMode() => commandMode = CommandMode.Attack;
    private void EnableGatherMode() => commandMode = CommandMode.Gather;
    private void EnableBuildMode(string buildingType)
    {
        commandMode = CommandMode.Build;
        buildingTypeToBuild = buildingType;
    }

    private void EnableBuildBarracks() => EnableBuildMode("Barracks");
    private void EnableBuildResourceDepot() => EnableBuildMode("ResourceDepot");

    private Task ProduceWorker(int buildingId) => ProduceUnit(buildingId, "Worker");
    private Task ProduceSoldier(int buildingId) => ProduceUnit(buildingId, "Soldier");
    private Task ProduceScout(int buildingId) => ProduceUnit(buildingId, "Scout");

    private string GetCommandModeInstruction() => commandMode switch
    {
        CommandMode.Move => "move units to that location",
        CommandMode.Attack => "attack-move to that location",
        CommandMode.Gather => "gather resources at that location",
        CommandMode.Build => $"build a {buildingTypeToBuild} at that location",
        _ => ""
    };

    private void ExitGame()
    {
        Navigation.NavigateTo("/lobbies");
    }

    private List<UnitDto> GetMyUnits()
    {
        return gameState?.Units.Where(u => u.PlayerId == playerId).ToList() ?? new List<UnitDto>();
    }

    private List<BuildingDto> GetMyBuildings()
    {
        return gameState?.Buildings.Where(b => b.PlayerId == playerId).ToList() ?? new List<BuildingDto>();
    }

    private bool IsPositionVisible(int x, int y)
    {
        if (gameState == null) return false;

        // Check if position is in visible tiles
        return gameState.VisibleTiles.Any(t => t.Position.X == x && t.Position.Y == y);
    }

    private string GetOwnerClass(Guid ownerId)
    {
        if (ownerId == playerId)
            return "player-self";
        else if (ownerId == Guid.Empty)
            return "player-neutral";
        else
            return "player-enemy";
    }

    private string GetUnitIcon(string type)
    {
        return type switch
        {
            "Worker" => "👷",
            "Soldier" => "⚔️",
            "Scout" => "👁️",
            _ => "?",
        };
    }

    private string GetBuildingIcon(string type)
    {
        return type switch
        {
            "CommandCenter" => "🏰",
            "Barracks" => "🏛️",
            "ResourceDepot" => "🏪",
            _ => "🏗️",
        };
    }

    private string GetStatusBadgeClass()
    {
        return gameState?.MatchStatus switch
        {
            "InProgress" => "bg-success",
            "Active" => "bg-success",
            "Completed" => "bg-info",
            "Cancelled" => "bg-secondary",
            _ => "bg-warning",
        };
    }

    public async ValueTask DisposeAsync()
    {
        if (hubConnection != null)
        {
            await hubConnection.DisposeAsync();
        }
    }
}

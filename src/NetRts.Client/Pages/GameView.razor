@page "/game/{MatchId:guid}"
@layout NetRts.Client.Layout.EmptyLayout
@using NetRts.Client.Services
@using NetRts.Client.Components
@using NetRts.Contracts.Responses
@using Microsoft.AspNetCore.SignalR.Client
@inject AuthenticatedHttpClient Http
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>Game - Match @MatchId.ToString().Substring(0, 8)</PageTitle>

<div class="game-container">
    @if (gameState == null)
    {
        <div class="loading-overlay">
            <div class="spinner-border text-light" role="status">
                <span class="visually-hidden">Loading game...</span>
            </div>
        </div>
    }
    else
    {
        <div class="game-header p-2 bg-dark border-bottom">
            <div class="container-fluid">
                <div class="row align-items-center">
                    <div class="col-auto">
                        <button class="btn btn-sm btn-outline-light" @onclick="ExitGame">
                            <i class="bi bi-arrow-left"></i> Exit
                        </button>
                    </div>
                    <div class="col text-center">
                        <ResourceDisplay Resources="gameState.PlayerResources" Score="gameState.PlayerScore" />
                    </div>
                    <div class="col-auto">
                        <div class="stat-card">
                            <span class="stat-label small opacity-75">Tick:</span>
                            <span class="stat-value fw-bold">@gameState.CurrentTick</span>
                        </div>
                    </div>
                    <div class="col-auto">
                        <div class="@(isConnected ? "text-success" : "text-danger")">
                            <i class="bi @(isConnected ? "bi-wifi" : "bi-wifi-off")" title="@(isConnected ? "Connected" : "Disconnected")"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="game-content d-flex overflow-hidden">
            <div class="flex-grow-1 overflow-auto bg-dark p-3">
                <MapRenderer 
                    MapWidth="gameState.MapWidth" 
                    MapHeight="gameState.MapHeight"
                    CellSize="cellSize"
                    PlayerId="playerId"
                    Units="gameState.Units"
                    Buildings="gameState.Buildings"
                    ResourceDeposits="gameState.ResourceDeposits"
                    VisibleTiles="gameState.VisibleTiles"
                    SelectedUnitIds="selectedUnitIds"
                    SelectedBuildingId="selectedBuildingId"
                    OnCellClick="HandleCellClick"
                    OnUnitClick="HandleUnitClick"
                    OnBuildingClick="HandleBuildingClick" />
            </div>

            <div class="side-panel d-flex flex-column bg-secondary bg-opacity-10 border-start overflow-auto" style="width: 350px;">
                @if (commandMode != CommandMode.None)
                {
                    <div class="alert alert-warning m-3 shadow-sm">
                        <div class="fw-bold mb-1">@commandMode Mode</div>
                        <div class="small">Click on the map to @GetCommandModeInstruction()</div>
                        <button class="btn btn-sm btn-outline-dark mt-2 w-100" @onclick="CancelCommand">Cancel Action</button>
                    </div>
                }

                <div class="selection-details p-3 flex-grow-1">
                    @if (selectedUnitIds.Any())
                    {
                        var units = GetMyUnits().Where(u => selectedUnitIds.Contains(u.UnitId)).ToList();
                        <h6 class="mb-3">Selection (@units.Count)</h6>
                        @foreach (var unit in units.Take(5))
                        {
                            <UnitCard Unit="unit" />
                        }
                        @if (units.Count > 5)
                        {
                            <div class="text-center small text-muted">... and @(units.Count - 5) more ...</div>
                        }
                    }
                    else if (selectedBuildingId.HasValue)
                    {
                        var building = gameState.Buildings.FirstOrDefault(b => b.BuildingId == selectedBuildingId);
                        if (building != null)
                        {
                            <div class="card mb-3">
                                <div class="card-header @(building.PlayerId == playerId ? "bg-primary" : "bg-danger") text-white py-1">
                                    @building.BuildingType #@building.BuildingId
                                </div>
                                <div class="card-body p-2 small">
                                    <div>HP: @building.Health / @building.MaxHealth</div>
                                    <div>Status: @(building.IsConstructed ? "Operational" : $"Under Construction ({building.ConstructionProgress}%)")</div>
                                    <div>Position: (@building.Position.X, @building.Position.Y)</div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center mt-5 text-muted">
                            <i class="bi bi-mouse2 fs-1 d-block mb-3"></i>
                            Select units or buildings to view details and issue commands.
                        </div>
                    }
                </div>

                <CommandPanel 
                    SelectedUnits="GetMyUnits().Where(u => selectedUnitIds.Contains(u.UnitId))"
                    SelectedBuilding='gameState.Buildings.FirstOrDefault(b => b.BuildingId == selectedBuildingId && b.PlayerId == playerId)'
                    Resources="gameState.PlayerResources"
                    OnCommandSelected="HandleCommandTypeSelected"
                    OnBuildSelected="HandleBuildSelected"
                    OnProduceSelected="HandleProduceSelected"
                    OnResearchSelected="HandleResearchSelected" />
            </div>
        </div>
    }
</div>

<style>
    .game-container {
        position: fixed; top: 0; left: 0; right: 0; bottom: 0;
        display: flex; flex-direction: column; background: #121212; color: #eee;
    }
    .game-content { flex: 1; }
    .loading-overlay {
        position: fixed; top: 0; left: 0; right: 0; bottom: 0;
        background: #1a1a1a; display: flex; align-items: center; justify-content: center;
    }
    /* Map styles are handled by the component or shared CSS */
    ::deep .game-map { position: relative; background: #1a4d1a; box-shadow: 0 0 20px rgba(0,0,0,0.5); }
    ::deep .map-cell { position: absolute; border: 1px solid rgba(255,255,255,0.05); cursor: pointer; }
    ::deep .map-cell:hover { background: rgba(255,255,255,0.1); }
    ::deep .fog-of-war { background: rgba(0,0,0,0.7) !important; cursor: default !important; }
    ::deep .unit { position: absolute; border: 2px solid; border-radius: 50%; display: flex; align-items: center; justify-content: center; cursor: pointer; z-index: 10; font-size: 0.8rem; }
    ::deep .unit.selected { box-shadow: 0 0 10px white; transform: scale(1.1); }
    ::deep .building { position: absolute; border: 2px solid; border-radius: 0.25rem; display: flex; align-items: center; justify-content: center; cursor: pointer; z-index: 8; font-size: 1.5rem; }
    ::deep .building.selected { box-shadow: 0 0 15px white; transform: scale(1.05); }
    ::deep .player-self { background: #2563eb; border-color: #60a5fa; }
    ::deep .player-enemy { background: #dc2626; border-color: #f87171; }
    ::deep .resource-deposit { position: absolute; display: flex; align-items: center; justify-content: center; background: rgba(255, 215, 0, 0.2); border: 1px solid gold; border-radius: 50%; z-index: 5; }
    ::deep .construction-progress { position: absolute; bottom: 0; left: 0; height: 4px; background: #4ade80; }
</style>

@code {
    [Parameter] public Guid MatchId { get; set; }

    private GameStateResponse? gameState;
    private HubConnection? hubConnection;
    private bool isConnected = false;
    private Guid playerId => AuthService.PlayerId;
    private int cellSize = 24;
    private HashSet<int> selectedUnitIds = new();
    private int? selectedBuildingId = null;
    private CommandMode commandMode = CommandMode.None;
    private string? buildingTypeToBuild = null;

    private enum CommandMode { None, Move, Attack, Gather, Build }

    protected override async Task OnInitializedAsync()
    {
        if (!AuthService.IsAuthenticated) { Navigation.NavigateTo("/login"); return; }
        await LoadGameState();
        await InitializeSignalR();
    }

    private async Task LoadGameState()
    {
        try { gameState = await Http.GetFromJsonAsync<GameStateResponse>($"api/v1/matches/{MatchId}/state"); }
        catch (Exception ex) { Console.WriteLine($"Error loading game state: {ex.Message}"); }
    }

    private async Task InitializeSignalR()
    {
        hubConnection = new HubConnectionBuilder().WithUrl(Navigation.ToAbsoluteUri("/hubs/game")).WithAutomaticReconnect().Build();
        hubConnection.On<GameStateResponse>("GameStateUpdate", async (state) => { gameState = state; await InvokeAsync(StateHasChanged); });
        hubConnection.On("MatchEnded", async (object _) => { await LoadGameState(); await InvokeAsync(StateHasChanged); });
        hubConnection.Reconnecting += _ => { isConnected = false; InvokeAsync(StateHasChanged); return Task.CompletedTask; };
        hubConnection.Reconnected += async _ => { isConnected = true; await hubConnection.SendAsync("SubscribeToMatchAsPlayer", MatchId, playerId); await InvokeAsync(StateHasChanged); };
        hubConnection.Closed += _ => { isConnected = false; InvokeAsync(StateHasChanged); return Task.CompletedTask; };

        try { await hubConnection.StartAsync(); await hubConnection.SendAsync("SubscribeToMatchAsPlayer", MatchId, playerId); isConnected = true; }
        catch (Exception ex) { Console.WriteLine($"Error connecting to SignalR: {ex.Message}"); }
    }

    private void HandleUnitClick(int unitId)
    {
        var unit = gameState?.Units.FirstOrDefault(u => u.UnitId == unitId);
        if (unit?.PlayerId == playerId)
        {
            if (selectedUnitIds.Contains(unitId)) selectedUnitIds.Remove(unitId);
            else selectedUnitIds.Add(unitId);
            selectedBuildingId = null;
        }
        else
        {
            // If in attack mode, this is the target
            if (commandMode == CommandMode.Attack && selectedUnitIds.Any())
            {
                IssueCommand(new { CommandType = "Attack", UnitIds = selectedUnitIds.ToArray(), TargetId = unitId });
                commandMode = CommandMode.None;
            }
        }
    }

    private void HandleBuildingClick(int buildingId)
    {
        var building = gameState?.Buildings.FirstOrDefault(b => b.BuildingId == buildingId);
        if (building?.PlayerId == playerId)
        {
            selectedBuildingId = buildingId;
            selectedUnitIds.Clear();
        }
        else if (commandMode == CommandMode.Attack && selectedUnitIds.Any())
        {
            IssueCommand(new { CommandType = "Attack", UnitIds = selectedUnitIds.ToArray(), TargetId = buildingId });
            commandMode = CommandMode.None;
        }
    }

    private void HandleCellClick((int X, int Y) pos)
    {
        if (commandMode == CommandMode.None) { selectedUnitIds.Clear(); selectedBuildingId = null; return; }
        if (!selectedUnitIds.Any()) return;

        object? command = commandMode switch
        {
            CommandMode.Move => new { CommandType = "Move", UnitIds = selectedUnitIds.ToArray(), TargetPosition = new { pos.X, pos.Y } },
            CommandMode.Attack => new { CommandType = "AttackMove", UnitIds = selectedUnitIds.ToArray(), TargetPosition = new { pos.X, pos.Y } },
            CommandMode.Gather => new { CommandType = "Gather", UnitIds = selectedUnitIds.ToArray(), TargetPosition = new { pos.X, pos.Y } },
            CommandMode.Build => new { CommandType = "Build", UnitIds = selectedUnitIds.ToArray(), TargetPosition = new { pos.X, pos.Y }, BuildingType = buildingTypeToBuild },
            _ => null
        };

        if (command != null) IssueCommand(command);
        commandMode = CommandMode.None;
    }

    private void HandleCommandTypeSelected(CommandPanel.CommandType type) => commandMode = (CommandMode)((int)type + 1);
    private void HandleBuildSelected(string type) { commandMode = CommandMode.Build; buildingTypeToBuild = type; }
    private void HandleProduceSelected(string type) => IssueCommand(new { CommandType = "Produce", BuildingId = selectedBuildingId, UnitType = type });
    private void HandleResearchSelected(string type) => IssueCommand(new { CommandType = "Research", BuildingId = selectedBuildingId, UpgradeType = type });

    private async void IssueCommand(object command)
    {
        try { await Http.PostAsJsonAsync($"api/v1/matches/{MatchId}/commands", new { Commands = new[] { command } }); }
        catch (Exception ex) { Console.WriteLine($"Error issuing command: {ex.Message}"); }
    }

    private void CancelCommand() { commandMode = CommandMode.None; buildingTypeToBuild = null; }
    private string GetCommandModeInstruction() => commandMode switch { CommandMode.Move => "move", CommandMode.Attack => "attack", CommandMode.Gather => "gather", CommandMode.Build => $"build {buildingTypeToBuild}", _ => "" };
    private void ExitGame() => Navigation.NavigateTo("/lobbies");
    private List<UnitDto> GetMyUnits() => gameState?.Units.Where(u => u.PlayerId == playerId).ToList() ?? new List<UnitDto>();
    public async ValueTask DisposeAsync() { if (hubConnection != null) await hubConnection.DisposeAsync(); }
}

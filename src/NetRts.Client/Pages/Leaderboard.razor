@page "/leaderboard"
@using NetRts.Contracts.Responses
@inject HttpClient Http

<PageTitle>Leaderboard - NetRTS</PageTitle>

<div class="container mt-4">
    <h1 class="mb-4">
        <i class="bi bi-trophy me-2"></i>
        Leaderboard
    </h1>

    @if (loading)
    {
        <div class="text-center py-5">
            <div class="spinner-border" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else if (leaderboard == null || !leaderboard.Entries.Any())
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle me-2"></i>
            No players registered yet. Be the first to join!
        </div>
    }
    else
    {
        <div class="card">
            <div class="card-body p-0">
                <table class="table table-hover mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th style="width: 60px;">Rank</th>
                            <th>Player</th>
                            <th class="text-center">Score</th>
                            <th class="text-center">Matches</th>
                            <th class="text-center">Wins</th>
                            <th class="text-center">Win Rate</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var entry in leaderboard.Entries)
                        {
                            <tr>
                                <td>
                                    @if (entry.Rank == 1)
                                    {
                                        <span class="badge bg-warning text-dark">🥇 1</span>
                                    }
                                    else if (entry.Rank == 2)
                                    {
                                        <span class="badge bg-secondary">🥈 2</span>
                                    }
                                    else if (entry.Rank == 3)
                                    {
                                        <span class="badge bg-danger">🥉 3</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">@entry.Rank</span>
                                    }
                                </td>
                                <td>
                                    <strong>@entry.Username</strong>
                                </td>
                                <td class="text-center">
                                    <strong class="text-primary">@entry.TotalScore</strong>
                                </td>
                                <td class="text-center">@entry.MatchesPlayed</td>
                                <td class="text-center text-success">@entry.TotalWins</td>
                                <td class="text-center">@entry.WinRate.ToString("P1")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    private LeaderboardResponse? leaderboard;
    private bool loading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadLeaderboard();
    }

    private async Task LoadLeaderboard()
    {
        loading = true;
        try
        {
            var response = await Http.GetAsync("api/v1/leaderboard");
            if (response.IsSuccessStatusCode)
            {
                leaderboard = await response.Content.ReadFromJsonAsync<LeaderboardResponse>();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading leaderboard: {ex.Message}");
        }
        finally
        {
            loading = false;
        }
    }
}

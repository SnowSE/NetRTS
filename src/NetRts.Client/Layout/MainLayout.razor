@inherits LayoutComponentBase
@using NetRts.Client.Services
@inject AuthService AuthService
@inject NavigationManager Navigation

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4 d-flex justify-content-between align-items-center">
            <span></span>
            <div class="d-flex align-items-center gap-3">
                @if (AuthService.IsAuthenticated && AuthService.CurrentPlayer != null)
                {
                    <span class="text-muted">
                        <i class="bi bi-person-circle me-1"></i>
                        @AuthService.CurrentPlayer.Username
                        <span class="badge bg-secondary ms-1">ELO: @AuthService.CurrentPlayer.CurrentElo</span>
                    </span>
                    <button class="btn btn-outline-secondary btn-sm" @onclick="Logout">
                        <i class="bi bi-box-arrow-right"></i> Logout
                    </button>
                }
                else
                {
                    <a href="/login" class="btn btn-outline-primary btn-sm">
                        <i class="bi bi-box-arrow-in-right"></i> Login
                    </a>
                    <a href="/register" class="btn btn-primary btn-sm">
                        <i class="bi bi-person-plus"></i> Register
                    </a>
                }
            </div>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

@code {
    protected override void OnInitialized()
    {
        AuthService.OnAuthStateChanged += StateHasChanged;
    }

    private async Task Logout()
    {
        await AuthService.LogoutAsync();
        Navigation.NavigateTo("/");
    }

    public void Dispose()
    {
        AuthService.OnAuthStateChanged -= StateHasChanged;
    }
}
